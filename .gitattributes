*.mp3 filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text

# Footage acquisition produces compact review-ready clips (each well below
# GitHub's 100 MB per-file limit, and the acquisition workflow refuses any
# above 95 MB). Store them as normal Git blobs so acquisition does not depend
# on Git LFS quota or LFS upload auth. This is a property of how the system
# acquires footage, not of any one film, so it applies to every project --
# naming a single project here left every later project's clips routed
# through LFS while the workflow demanded normal blobs.
projects/*/assets/footage/*.mp4 -filter -diff -merge -text

# Official evidence captures are compact, verified production assets. Store
# rendered JPEG/PNG evidence as normal Git blobs so evidence acquisition is
# reproducible without a Git LFS quota or upload-auth dependency.
projects/*/assets/evidence/*.png -filter -diff -merge -text
projects/*/assets/evidence/*.jpg -filter -diff -merge -text
projects/*/assets/evidence/*.jpeg -filter -diff -merge -text

# Contact sheets exist to be looked at during review, so they must be
# fetchable without LFS for the same reason.
projects/*/qa/footage-contact-sheets/*.jpg -filter -diff -merge -text

# Committed as a plain blob (LFS push is blocked in the session that added
# it -- see scripts/README.md / the commit that introduced this file), so the
# general *.mp3 LFS rule above is explicitly unset for this one path. Without
# this, git runs the LFS clean filter against the working-tree copy for
# status/diff purposes, compares it to the raw blob actually committed, and
# reports a false modification. Migrate this back under the general rule
# once it is properly re-committed through Git LFS.
projects/*/assets/audio/final_voice.mp3 -filter -diff -merge -text
