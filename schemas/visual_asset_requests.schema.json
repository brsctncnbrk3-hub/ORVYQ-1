{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orvyq.dev/schemas/visual_asset_requests.schema.json",
  "title": "ORVYQ visual asset requests",
  "type": "object",
  "required": ["schema_version", "project_id", "policy", "requests"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "project_id": { "type": "string", "pattern": "^[0-9]{3}-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "policy": {
      "type": "object",
      "required": ["automatic_backfill_forbidden", "decorative_document_recreation_forbidden", "same_content_different_crop_counts_once"],
      "additionalProperties": { "type": "boolean" }
    },
    "requests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["asset_request_id", "type", "status", "claim_ids", "required_content", "acceptance", "forbidden_substitutes"],
        "properties": {
          "asset_request_id": { "type": "string", "pattern": "^REQ_(EVD|FTG)_[A-Z0-9_]+$" },
          "type": { "enum": ["primary_evidence", "contextual_footage"] },
          "status": { "enum": ["pending_direct_asset", "pending_acquisition", "pending_frame_review", "ready"] },
          "claim_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^CLM_[A-Z0-9_]+$" } },
          "required_source": { "type": "string", "minLength": 8 },
          "required_content": { "type": "string", "minLength": 24 },
          "acceptance": { "type": "string", "minLength": 24 },
          "forbidden_substitutes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
          "resolved_asset_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 8 } },
          "resolved_evidence_asset_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^EVID_[A-Z0-9_]+$" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
